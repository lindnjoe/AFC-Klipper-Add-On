(kicad_pcb (version 20221018) (generator bridgebox_s3)

  (general
    (thickness 1.6)
  )

  (paper "A4")
  (title_block
    (title "BridgeBox S3 carrier")
    (comment 1 "Antenna overhangs the TOP edge: the WROOM-1 keepout is 48 x 21 mm past it and must stay in free air.")
    (comment 2 "Both layers are signal + GND pour, stitched. BUS_A/BUS_B stay on F.Cu and cross at the transceiver -- U2.B is BUS_A.")
    (comment 3 "Placement only -- tracks are route.py. This comment is true; check it before believing it.")
  )

  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )

  (setup
    (pad_to_mask_clearance 0)
  )

  (net 0 "")
  (net 1 "+24V")
  (net 2 "+24V_IN")
  (net 3 "+3V3")
  (net 4 "BOOT")
  (net 5 "BOOT_C")
  (net 6 "BUS_A")
  (net 7 "BUS_B")
  (net 8 "DE")
  (net 9 "EN")
  (net 10 "FB")
  (net 11 "GND")
  (net 12 "RXD")
  (net 13 "SW")
  (net 14 "TXD")
  (net 15 "USB_CC1")
  (net 16 "USB_CC2")
  (net 17 "USB_DM")
  (net 18 "USB_DP")
  (net 19 "USB_VBUS")

